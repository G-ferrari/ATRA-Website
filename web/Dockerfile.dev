# Desenvolvimento apenas. O build de produção é multi-stage — ver docs/04-infra/docker.md.
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /app
EXPOSE 3000

# Código vem por bind mount; dependências ficam num volume próprio para não
# serem sobrescritas pelo host (e para o binário nativo bater com o Linux).
CMD ["sh", "-c", "pnpm install --frozen-lockfile && pnpm migrate && pnpm dev"]
