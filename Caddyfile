# Proxy reverso do site novo. Ver docs/04-infra/ambientes.md.
#
# O hostname decide o certificado: o Caddy pede à Let's Encrypt sozinho, na
# primeira requisição, e renova sem cron.
#
# `SITE_HOST` aceita **vários nomes separados por vírgula**, e é assim que ele
# está: o hostname da Hostinger, que funciona hoje, mais `staging.atra.com.br`,
# que espera um registro A no Cloudflare (P-23). Enquanto o registro não existe,
# o Caddy só anota `NXDOMAIN` nesse nome e continua servindo o outro
# normalmente — verificado. No minuto em que o A for criado, apontando para o IP
# da VPS com a nuvem **cinza**, basta recriar este container e o certificado sai
# em segundos.
#
# ⚠️ Nuvem cinza, não laranja. Com o proxy da Cloudflare ligado quem chega aqui
# é a Cloudflare, e o limite por IP do formulário (MIG-101) e do chat (D-12)
# passa a contar todos os visitantes como um só. Ligar o proxy é a P-21, e a
# recomendação registrada é depois do cutover estabilizar.
#
# ⚠️ Promover `staging.atra.com.br` a endereço principal **não é só trocar este
# hostname**. `NEXT_PUBLIC_SITE_URL` entra na imagem em tempo de build e é dele
# que saem a URL canônica, o `hreflang`, o sitemap e o JSON-LD (MIG-105/106/107).
# Mudar o principal sem reconstruir publica canônicas apontando para o endereço
# antigo — que é pior do que não ter canônica.

{$SITE_HOST} {
	encode zstd gzip

	# ⚠️ Enquanto isto for ambiente de homologação, **noindex é obrigatório**.
	#
	# O conteúdo aqui é idêntico ao de atra.com.br — 207 artigos, os mesmos
	# cases, os mesmos segmentos. Indexado, compete com a produção pelas mesmas
	# buscas e o Google escolhe um dos dois. É a nota de ambientes.md, e o
	# estrago é real justamente porque a cópia é fiel.
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		# Cabeçalhos de origem não vazam a pilha para quem varre a internet.
		-Server
		-X-Powered-By
	}

	# Mesma razão: robots.txt do app libera o rastreamento, porque ele foi
	# escrito para a produção. Aqui a resposta é substituída antes de chegar nele.
	handle /robots.txt {
		respond "User-agent: *
Disallow: /" 200
	}

	# ⚠️ A senha protege o ambiente, não o conteúdo — ele é o mesmo que já está
	# público em atra.com.br. Serve para robô não entrar e para link vazado não
	# virar site paralelo. O hash é bcrypt, gerado por `caddy hash-password`.
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	reverse_proxy web:3000 {
		# O Next confia nestes para montar URL absoluta e ler o IP de quem
		# chega — o limite por IP do formulário e do chat dependem disso
		# (MIG-101, D-12). Sem eles, todo visitante é o container do Caddy.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
