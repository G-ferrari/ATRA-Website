# Proxy reverso do site. Ver docs/04-infra/ambientes.md.
#
# O hostname decide o certificado: o Caddy pede à Let's Encrypt sozinho, na
# primeira requisição, e renova sem cron.
#
# Dois blocos, dois papéis (D-72):
#
# - `SITE_HOST` serve o site. Em produção é **um nome só**, `www.atra.com.br`:
#   o primeiro nome dele é o que o `deploy.sh` confere depois da troca.
# - `REDIRECT_HOSTS` só redireciona, com 301, para `SITE_URL` mantendo caminho
#   e query: o apex, `atra.digital`, `atrainformatica.com.br` (com e sem `www`)
#   e o nome da homologação. Aceita vários nomes separados por vírgula.
#
# ⚠️ Um domínio a mais servindo o site, e não redirecionando, é conteúdo
# duplicado: o Google escolhe sozinho qual dos dois indexa. Domínio novo entra
# em `REDIRECT_HOSTS`, nunca em `SITE_HOST`.
#
# ⚠️ Nuvem cinza, não laranja. Com o proxy da Cloudflare ligado quem chega aqui
# é a Cloudflare, e o limite por IP do formulário (MIG-101) e do chat (D-12)
# passa a contar todos os visitantes como um só. Ligar o proxy é a P-21.
#
# ⚠️ Mudar o domínio principal **não é só trocar este hostname**.
# `NEXT_PUBLIC_SITE_URL` entra na imagem em tempo de build e é dele que saem a
# URL canônica, o `hreflang`, o sitemap e o JSON-LD (MIG-105/106/107). Mudar o
# principal sem reconstruir publica canônicas apontando para o endereço antigo
# — que é pior do que não ter canônica.

# Log de acesso em JSON, em arquivo no host (`./logs/caddy`, montado pelo
# compose), 30 dias. É o insumo do monitoramento de 404 pós-cutover que o
# runbook pede, e a única evidência de 502 durante um deploy — o stderr do
# container (erros do próprio Caddy) continua indo para o journald, mas morre
# com o container a cada `--force-recreate`; o arquivo sobrevive. Os
# redirecionamentos entram no mesmo arquivo: é por eles que se vê quanto
# tráfego ainda chega pelos domínios antigos.
(log_de_acesso) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 30
			roll_keep_for 720h
		}
		format json
	}
}

{$SITE_HOST} {
	encode zstd gzip
	import log_de_acesso

	# O `noindex` e o `robots.txt` bloqueando saíram com a virada (D-72): esta
	# VM é a produção. O `robots.txt` que vale é o do app (`app/robots.ts`).
	header {
		# Cabeçalhos de origem não vazam a pilha para quem varre a internet.
		-Server
		-X-Powered-By
	}

	# MIG-104: o caminho público das URLs pré-assinadas do bucket privado.
	# O MinIO segue sem porta exposta — só se chega por aqui, e sem assinatura
	# válida ele responde 403 (provado). Declarado ANTES do proxy geral: a
	# primeira rota que casa vence.
	#
	# ⚠️ `-Authorization` fica mesmo sem a senha do site: o MinIO interpreta
	# qualquer header Authorization como assinatura AWS, e um navegador que
	# ainda guarde o Basic antigo quebraria a URL pré-assinada. Daqui para
	# dentro vale só a assinatura da URL.
	reverse_proxy /atra-privado/* minio:9000 {
		header_up -Authorization
	}

	reverse_proxy web:3000 {
		# O Next confia nestes para montar URL absoluta e ler o IP de quem
		# chega — o limite por IP do formulário e do chat dependem disso
		# (MIG-101, D-12). Sem eles, todo visitante é o container do Caddy.
		header_up X-Real-IP {remote_host}
		# ⚠️ Sobrescreve, não anexa. O padrão do Caddy é ANEXAR o IP real ao
		# X-Forwarded-For que o cliente mandou — e o app lia o primeiro da
		# lista, que é o forjado. O app agora prefere o X-Real-IP (lib/ip.ts),
		# e esta linha garante que, mesmo se alguém voltar a ler XFF, o
		# conteúdo é só o que o proxy afirma.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# 301 e não o 308 do `permanent`: é o que o runbook do cutover confere (passo
# 18), e o que todo robô e cliente antigo entende como mudança definitiva.
# `{uri}` leva caminho e query: `atra.com.br/sobre` cai em `www…/sobre`, e de
# lá os redirects do WordPress (`redirects.csv`) seguem valendo.
#
# ⚠️ O `:localhost` não é enfeite. Com a variável vazia o bloco fica sem nome,
# e o Caddy recusa o arquivo inteiro ("server block without any key") — o site
# cai, não só o redirect. `localhost` usa a CA interna do Caddy: não pede nada à
# Let's Encrypt e ninguém de fora chega nele.
{$REDIRECT_HOSTS:localhost} {
	import log_de_acesso
	redir {$SITE_URL}{uri} 301
}
